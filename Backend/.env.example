SLACK_BOT_TOKEN=
SLACK_USER_TOKEN=
SLACK_ADMIN_TOKEN=
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=

# ── Approval email (license request flow) ─────────────────────────────
# Transport: MAIL_TRANSPORT=auto | graph | smtp | log   (default: auto)
#   auto  -> Microsoft Graph if MS_* creds exist, else SMTP, else log file.
#   NOTE: SMTP AUTH (smtp.office365.com login) is DISABLED for this tenant —
#   Microsoft rejects it with 5.7.139, so Graph is the working transport.
#   SMTP_* settings are kept only as a fallback for other tenants.
MAIL_TRANSPORT=auto
MAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=true
# Base URL used in the Approve/Decline links inside approval emails
PORTAL_BASE_URL=http://localhost:3000
