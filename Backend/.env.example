SLACK_BOT_TOKEN=
SLACK_USER_TOKEN=
SLACK_ADMIN_TOKEN=
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=

# ── Approval email (license request flow) ─────────────────────────────
# Leave SMTP_HOST / SMTP_USER empty to run in dev mode: emails are then
# written to Backend/logs/approval_emails.log instead of being sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=true
# Base URL used in the Approve/Decline links inside approval emails
PORTAL_BASE_URL=http://localhost:3000
